APP_NAME=AI-Powered Medicine Order Calling Agent API
APP_ENV=development
LOG_LEVEL=INFO
SQL_ECHO=false
ORDER_SESSION_TTL_MINUTES=30
MAX_ORDER_ITEM_QUANTITY=100
FUZZY_MATCH_THRESHOLD=0.72
FUZZY_CONFIRMATION_THRESHOLD=0.55
FUZZY_MATCH_LIMIT=5

VOICE_ENABLED=true
VOICE_SESSION_TTL_MINUTES=30
VOICE_MAX_AUDIO_BYTES=10000000
VOICE_MAX_TRANSCRIPT_CHARS=1000
VOICE_MAX_TURNS=100
VOICE_MAX_TTS_CHARS=600
# Optional demo warm-up: load Whisper and Kokoro in the background at startup.
VOICE_PRELOAD_MODELS=false
# Speech-to-text: Sarvam AI for calls (Hindi/English/Hinglish, phone audio),
# local Whisper as automatic backup. Get the key from the project owner; never
# commit it. See docs/SARVAM_SETUP.md. Leave the key empty to use Whisper only.
VOICE_STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_LANGUAGE=unknown
SARVAM_TIMEOUT_SECONDS=8
VOICE_STT_MODEL=small
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_BEAM_SIZE=1
VOICE_STT_LANGUAGE=hi
VOICE_STT_FALLBACK_LANGUAGE=en
VOICE_STT_INITIAL_PROMPT=
VOICE_STT_VAD_FILTER=true
VOICE_STT_VAD_THRESHOLD=0.35
VOICE_STT_VAD_MIN_SILENCE_MS=700
VOICE_STT_VAD_SPEECH_PAD_MS=400
# Measured locally to slow short turns 15-20x and leak hints into transcripts.
VOICE_STT_HOTWORDS_ENABLED=false
VOICE_TTS_ENABLED=true
VOICE_TTS_VOICE_HI=hf_alpha
VOICE_TTS_VOICE_EN=af_heart
VOICE_TTS_SPEED=1.0
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
VOICE_LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=8

POSTGRES_USER=medicine_user
POSTGRES_PASSWORD=change_me_before_running
POSTGRES_DB=medicine_agent

DATABASE_URL=postgresql+psycopg://medicine_user:change_me_before_running@localhost:5432/medicine_agent
TEST_DATABASE_URL=postgresql+psycopg://medicine_user:change_me_before_running@localhost:5432/medicine_agent_test


# Phase 4: safe disabled defaults. Never publish actual secrets.
API_PORT=8001
TELEPHONY_PROVIDER=exotel
TELEPHONY_ENABLED=false
TELEPHONY_PUBLIC_BASE_URL=
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_STREAM_USERNAME=
TELEPHONY_STREAM_TOKEN=
TELEPHONY_MONITOR_TOKEN=
TELEPHONY_DEMO_NUMBER=
# Plivo Audio Streaming (monthly plan, runs alongside Exotel). Needs
# TELEPHONY_ENABLED=true and TELEPHONY_PUBLIC_BASE_URL. Generate the token with
# `openssl rand -hex 24`; the Plivo Application's Answer URL (POST) is
# <TELEPHONY_PUBLIC_BASE_URL>/telephony/plivo/answer/<PLIVO_STREAM_TOKEN>.
# Optional PLIVO_AUTH_ID rejects streams from any other Plivo account.
PLIVO_STREAM_TOKEN=
PLIVO_AUTH_ID=
# Exotel Account SID from the dashboard.
EXOTEL_ACCOUNT_SID=
# REST API credentials for POST /v1/Accounts/{sid}/Calls/connect.
# These are separate from TELEPHONY_STREAM_USERNAME/TOKEN used on the WSS handshake.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# https://api.exotel.com (Singapore) or https://api.in.exotel.com (India).
EXOTEL_API_BASE_URL=https://api.exotel.com
# Your activated ExoPhone used as CallerId for outbound calls.
EXOTEL_CALLER_ID=
# Public HTTPS origin that Exotel can reach; the app derives /telephony/media (wss)
# and /telephony/status-callback (https) from it.
TELEPHONY_PUBLIC_BASE_URL=
# Optional comma-separated E.164 allowlist for outbound demo destinations.
TELEPHONY_ALLOWED_DESTINATIONS=
TELEPHONY_MAX_CALL_SECONDS=600
TELEPHONY_SILENCE_SECONDS=45
TELEPHONY_VAD_THRESHOLD=450
TELEPHONY_TURN_QUEUE_SIZE=4

# Private local dashboard read access; never use a VITE_ prefix for this secret.
DASHBOARD_ENABLED=false
DASHBOARD_TOKEN=
